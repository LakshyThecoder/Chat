# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (set project_ref in .cursor/mcp.json)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer either ANON_KEY (legacy JWT) or PUBLISHABLE_KEY (new sb_publishable_*)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Regolo AI
REGOLO_API_KEY=
REGOLO_BASE_URL=https://api.regolo.ai/v1
REGOLO_MODEL_FAST=qwen3.5-9b
REGOLO_MODEL_REASONING=Llama-3.3-70B-Instruct

# Optional observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional email/notifications
NOTIFICATION_PROVIDER_API_KEY=
