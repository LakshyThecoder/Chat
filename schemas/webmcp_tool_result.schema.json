{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebMCPToolResult",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "SUCCESS",
        "REJECTED",
        "CONFLICT",
        "UNAVAILABLE",
        "DUPLICATE"
      ]
    },
    "providerReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}