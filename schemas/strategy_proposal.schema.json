{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyProposal",
  "type": "object",
  "required": [
    "strategies"
  ],
  "properties": {
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requestedOutcome",
          "reason",
          "evidenceIds",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "requestedOutcome": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}