{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractedCaseFacts",
  "type": "object",
  "required": [
    "facts",
    "sourceReferences"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "value",
          "sourceReference",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {},
          "sourceReference": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}